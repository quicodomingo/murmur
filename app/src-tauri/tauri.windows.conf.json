{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Murmur",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main"
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "windows-dlls/*.dll": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Catalan",
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}

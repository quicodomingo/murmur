{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the floating alert",
  "windows": [
    "main",
    "toast"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-open",
    "autostart:default"
  ]
}

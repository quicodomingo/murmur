{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur",
  "version": "0.7.2",
  "identifier": "com.quicodomingo.murmur",
  "build": {
    "beforeDevCommand": "npm run whisper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run whisper && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Murmur",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/screens/**",
          "$APPCACHE/playback/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "externalBin": ["binaries/murmur-whisper"],
    "resources": {
      "locales/ca.lproj/InfoPlist.strings": "ca.lproj/InfoPlist.strings",
      "locales/es.lproj/InfoPlist.strings": "es.lproj/InfoPlist.strings",
      "locales/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings"
    },
    "copyright": "© 2026 Quico Domingo",
    "macOS": {
      "signingIdentity": "Developer ID Application: We Are Mortensen S.L. (NYQHV4FSKC)",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.2"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NDdFQjIwQ0Q4MDM3RTAKUldUZ040RE5JT3RITnNSbnpVM3dndC9lSmFtQU1YTUZwdUh6SndpR2hwL2FnU2doaEVEMDdzM2QK",
      "endpoints": [
        "https://github.com/quicodomingo/murmur-releases/releases/latest/download/latest.json"
      ]
    }
  }
}

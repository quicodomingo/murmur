<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: without this the microphone is blocked silently. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Hardened runtime: needed to read the calendar (EventKit). -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
  <!-- The folder the Share menu's extension leaves copies in (share-extension/). -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>NYQHV4FSKC.com.quicodomingo.murmur</string>
  </array>
</dict>
</plist>

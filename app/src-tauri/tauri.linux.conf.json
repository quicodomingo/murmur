        "depends": [
          "libgomp1",
          "libpulse0"
        ]
      },
      "rpm": {
        "depends": [
          "libgomp",
          "pulseaudio-libs"
        ]
      }
    },
    "resources": {
      "linux-libs/*": "./"
    }
  },

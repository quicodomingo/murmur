      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prem el botó i llegeix la frase en veu alta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón y lee la frase en voz alta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the button and read the sentence aloud."
          }
        }
      }
    },
    "voice.saved": {
      "extractionState": "manual",

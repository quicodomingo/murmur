    "onboarding.micDenied": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense el micròfon no es pot gravar. El pots activar a la Configuració de l'iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin el micrófono no se puede grabar. Lo puedes activar en los Ajustes del iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the microphone it can't record. You can allow it in the iPhone's Settings."
          }
        }
      }
    },
    "onboarding.micKicker": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permís"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permiso"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One permission"
          }
        }
      }
    },
    "onboarding.micText": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per escoltar la reunió i transcriure-la. L'àudio es queda al telèfon: res no va a cap servidor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escuchar la reunión y transcribirla. El audio se queda en el teléfono: nada va a ningún servidor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To listen to the meeting and transcribe it. The audio stays on the phone: nothing goes to any server."
          }
        }
      }
    },
    "onboarding.micTitle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur necessita el micròfon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur necesita el micrófono"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur needs the microphone"
          }
        }
      }
    },

    "onboarding.voiceKicker": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional"
          }
        },
        "en": {
          "stringUnit": {

          "stringUnit": {
            "state": "translated",
            "value": "És una dada biomètrica: una empremta de com sona la teva veu, no cap gravació. Es queda només en aquest telèfon i no passa mai a l'ordinador."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un dato biométrico: una huella de cómo suena tu voz, no una grabación. Se queda solo en este teléfono y nunca pasa al ordenador."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is biometric data: a print of how your voice sounds, not a recording. It stays only on this phone and never goes to the computer."
          }
        }
      }
    },
    "voice.cancel": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel·la"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "voice.delete": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esborra la teva veu…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar tu voz…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Your Voice…"
          }
        }
      }
    },
    "voice.deleteConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esborra"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "voice.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur deixarà de reconèixer-te automàticament. La pots tornar a gravar quan vulguis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur dejará de reconocerte automáticamente. La puedes volver a grabar cuando quieras."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur will stop recognising you automatically. You can record it again whenever you like."
          }
        }
      }
    },
    "voice.deleteTitle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols esborrar la teva veu?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres borrar tu voz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your voice?"
          }
        }
      }
    },
    "voice.listening": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escoltant · llegeix-la en veu alta"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando · léela en voz alta"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening · read it aloud"
          }
        }
      }
    },
    "voice.none": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegeix una frase i Murmur et reconeixerà com a «Tu», també quan sou més gent a la sala."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee una frase y Murmur te reconocerá como «Tú», también cuando sois más en la sala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a sentence and Murmur will know you as “You”, also when there are more of you in the room."
          }
        }
      }
    },
    "voice.notSaved": {
      "extractionState": "manual",
      "localizations": {

            "value": "Optional"
          }
        }
      }
    },
    "onboarding.voiceText": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una empremta de la teva veu, no una gravació: una dada biomètrica. Es queda en aquest telèfon i la pots esborrar a Configuració."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una huella de tu voz, no una grabación: un dato biométrico. Se queda en este teléfono y la puedes borrar en Ajustes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A print of your voice, not a recording: biometric data. It stays on this phone and you can delete it in Settings."
          }
        }
      }
    },
    "onboarding.voiceTitle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes que Murmur et reconegui"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que Murmur te reconozca"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Murmur recognise you"
          }
        }
      }
    },
    "onboarding.welcomePrivate": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat, perquè tot passa al telèfon. Res no surt d'aquí si tu no ho vols."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado, porque todo pasa en el teléfono. Nada sale de aquí si tú no quieres."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private, because it all happens on the phone. Nothing leaves it unless you want it to."
          }
        }
      }
    },
    "onboarding.welcomeTagline": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriu les teves reunions en directe, amb el català al centre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe tus reuniones en directo, con el catalán en el centro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe your meetings live, with Catalan at the centre."
          }
        }
      }
    },
    "onboarding.welcomeTitle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvinguda a Murmur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenida a Murmur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Murmur"
          }
        }
      }
    },
    "pair.after": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després, cada reunió que facis amb el mòbil passarà a l'ordinador quan siguin a la mateixa xarxa, xifrada. L'ordinador la tornarà a escoltar i et tornarà el resum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, cada reunión que hagas con el móvil pasará al ordenador cuando estén en la misma red, cifrada. El ordenador la volverá a escuchar y te devolverá el resumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then every meeting you record on the phone goes to the computer, encrypted, when both are on the same network. The computer listens to it again and sends you back the summary."
          }
        }
      }
    },
    "pair.connecting": {
      "extractionState": "manual",
      "localizations": {

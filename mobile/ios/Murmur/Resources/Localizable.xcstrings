    "settings.computerHint": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reunions hi passaran soles quan siguin a la mateixa xarxa: l'ordinador les torna a escoltar amb Whisper i en fa el resum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones pasarán solas cuando estén en la misma red: el ordenador las vuelve a escuchar con Whisper y hace el resumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetings go to it on their own when both are on the same network: the computer listens to them again with Whisper and writes the summary."
          }
        }
      }
    },
    "settings.keepAudio": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa l'àudio al telèfon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar el audio en el teléfono"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the audio on the phone"
          }
        }
      }
    },
    "settings.keepAudioHint": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivat, l'àudio s'esborra del telèfon quan l'ordinador el té sencer, per fer lloc. L'ordinador el necessita per refer la reunió."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, el audio se borra del teléfono cuando el ordenador lo tiene entero, para hacer sitio. El ordenador lo necesita para rehacer la reunión."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the audio is deleted from the phone once the computer has all of it, to save space. The computer needs it to redo the meeting."
          }
        }
      }
    },
    "settings.language": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {

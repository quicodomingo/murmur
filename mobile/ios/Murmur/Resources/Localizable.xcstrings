    "recMenu.discardMessage": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'aturarà i s'esborrarà del telèfon, amb l'àudio i les notes. No es pot desfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detendrá y se borrará del teléfono, con el audio y las notas. No se puede deshacer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will stop and be deleted from the phone, with its audio and notes. This can't be undone."
          }
        }
      }
    },

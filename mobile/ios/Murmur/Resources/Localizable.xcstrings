        }
      }
    },
    "voice.savedText": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur et reconeix com a «Tu» a totes les reunions que graves amb aquest telèfon, també quan sou més gent a la sala."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur te reconoce como «Tú» en todas las reuniones que grabas con este teléfono, también cuando sois más en la sala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur knows you as “You” in every meeting you record with this phone, also when there are more of you in the room."
          }
        }
      }
    },
    "voice.saving": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desant…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        }
      }
    },
    "voice.sentence": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon dia. Sóc qui fa servir aquest telèfon, i aquesta és la meva veu quan parlo en una reunió."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buenos días. Soy quien usa este teléfono, y esta es mi voz cuando hablo en una reunión."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good morning. I'm the one who uses this phone, and this is my voice when I speak in a meeting."
          }
        }
      }
    },

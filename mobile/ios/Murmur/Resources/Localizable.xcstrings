    "pair.noCamera": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur necessita la càmera per llegir el codi. Pots donar-li permís a la Configuració de l'iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur necesita la cámara para leer el código. Puedes darle permiso en los Ajustes del iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur needs the camera to read the code. You can allow it in the iPhone's Settings."
          }
        }
      }
    },

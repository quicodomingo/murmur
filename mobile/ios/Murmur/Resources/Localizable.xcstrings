    "meeting.deleteConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'esborrarà la reunió i l'àudio d'aquest telèfon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán la reunión y el audio de este teléfono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting and its audio will be deleted from this phone."
          }
        }
      }
    },
    "meeting.deleteConfirmComputer": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'esborrarà d'aquest telèfon i no hi tornarà a arribar. A l'ordinador es queda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrará de este teléfono y no volverá a llegar. En el ordenador se queda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be deleted from this phone and won't come back. It stays on the computer."
          }
        }
      }
    },
    "meeting.empty": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha sentit res."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha oído nada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was heard."
          }
        }
      }
    },
    "meeting.fromComputer": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravada a l'ordinador. Aquí tens el text, els parlants i el resum; l'àudio es queda a l'ordinador."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabada en el ordenador. Aquí tienes el texto, los hablantes y el resumen; el audio se queda en el ordenador."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded on the computer. Here you have the text, the speakers and the summary; the audio stays on the computer."
          }
        }
      }
    },
    "meeting.pending": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan el telèfon trobi l'ordinador, hi afegirà el títol, el resum i la passada de Whisper. Ara és la transcripció ràpida."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el teléfono encuentre el ordenador, añadirá el título, el resumen y la pasada de Whisper. Ahora es la transcripción rápida."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the phone finds your computer, it will add the title, the summary and the Whisper pass. For now this is the quick transcript."
          }
        }
      }
    },
    "meeting.pendingUnpaired": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara és la transcripció ràpida del telèfon. Connecta l'ordinador a Configuració i hi passarà sola: la tornarà a escoltar amb Whisper i en farà el resum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora es la transcripción rápida del teléfono. Conecta el ordenador en Ajustes y pasará sola: la volverá a escuchar con Whisper y hará el resumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the phone's quick transcript. Connect your computer in Settings and it'll go there on its own: it listens to it again with Whisper and writes the summary."
          }
        }
      }
    },
    "meeting.rename": {
      "extractionState": "manual",
      "localizations": {
        "ca": {

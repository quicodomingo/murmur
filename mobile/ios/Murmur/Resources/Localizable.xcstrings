          "stringUnit": {
            "state": "translated",
            "value": "Encima de la mesa"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the table"
          }
        }
      }
    },
    "onboarding.f3Text": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa'l a la taula: la reunió continua, i des de la pantalla bloquejada marques, pauses o atures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en la mesa: la reunión sigue, y desde la pantalla bloqueada marcas, pausas o detienes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it on the table: the meeting goes on, and from the lock screen you mark, pause or stop."
          }
        }
      }
    },
    "onboarding.f3Title": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava amb el telèfon bloquejat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba con el teléfono bloqueado"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record with the phone locked"
          }
        }
      }
    },
    "onboarding.f4Kicker": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "I a l'ordinador"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y en el ordenador"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And on the computer"
          }
        }
      }
    },
    "onboarding.f4Text": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb Murmur a l'ordinador i a la mateixa xarxa, cada reunió hi passa sola. L'ordinador la torna a escoltar, en fa el resum i te'l torna al telèfon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Murmur en el ordenador y en la misma red, cada reunión pasa sola. El ordenador la vuelve a escuchar, hace el resumen y te lo devuelve al teléfono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Murmur on your computer and on the same network, every meeting goes there on its own. The computer listens to it again, writes the summary and sends it back to the phone."
          }
        }
      }
    },
    "onboarding.f4Title": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunió, revisada i resumida"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunión, revisada y resumida"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting, revised and summarised"
          }
        }
      }
    },
    "onboarding.micAllow": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet el micròfon"
          }

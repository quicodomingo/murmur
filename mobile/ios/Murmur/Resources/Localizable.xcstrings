        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El codi ja no és a la pantalla de l'ordinador. Torna a obrir Connecta un mòbil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código ya no está en la pantalla del ordenador. Vuelve a abrir Conectar un móvil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code isn't on the computer's screen any more. Open Connect a Phone again."
